# Local server
PORT=5000
CLIENT_URL=http://localhost:5173

# Amazon Location Service server-side SDK
AWS_LOCATION_REGION=ap-south-1
# Optional: AWS_PROFILE=default
# Do NOT put AWS secret keys in this file. Use `aws configure` / AWS credential chain locally.

# Amazon Bedrock
AWS_BEDROCK_REGION=us-east-1
# Example: set a model available to your account/region.
BEDROCK_MODEL_ID=

# DynamoDB
DYNAMODB_TABLE_NAME=roamly-shared-places

# Limits
MAX_SEARCH_RADIUS_KM=50
DEFAULT_SEARCH_RADIUS_KM=5
PROVIDER_TIMEOUT_MS=12000
MAX_PLACES_PER_RESPONSE=80
MAX_RECOMMENDATION_PLACES=8
SHARE_TTL_DAYS=7
