FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .

ARG VITE_API_URL=http://localhost:5000/api
ARG VITE_AWS_LOCATION_API_KEY=
ARG VITE_AWS_LOCATION_REGION=ap-south-1
ARG VITE_AWS_MAP_STYLE=Standard
ARG VITE_AWS_MAP_COLOR_SCHEME=Light
ARG VITE_DEFAULT_SEARCH_RADIUS_KM=5
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_AWS_LOCATION_API_KEY=$VITE_AWS_LOCATION_API_KEY
ENV VITE_AWS_LOCATION_REGION=$VITE_AWS_LOCATION_REGION
ENV VITE_AWS_MAP_STYLE=$VITE_AWS_MAP_STYLE
ENV VITE_AWS_MAP_COLOR_SCHEME=$VITE_AWS_MAP_COLOR_SCHEME
ENV VITE_DEFAULT_SEARCH_RADIUS_KM=$VITE_DEFAULT_SEARCH_RADIUS_KM
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
