# Frontend API
VITE_API_URL=http://localhost:5000/api

# Amazon Location public API key used only for browser map rendering.
# Create a restricted key and add localhost:5173 as a client restriction during development.
VITE_AWS_LOCATION_API_KEY=
VITE_AWS_LOCATION_REGION=ap-south-1
VITE_AWS_MAP_STYLE=Standard
VITE_AWS_MAP_COLOR_SCHEME=Light

VITE_DEFAULT_SEARCH_RADIUS_KM=5
